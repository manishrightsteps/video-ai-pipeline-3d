NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Fallback voice (George — British male). Tutors in src/models/tutor.model.js set their own.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_MS=30000
# Fill after running: npm run agent:create
ELEVENLABS_AGENT_ID=
# LLM the ElevenLabs agent uses as the tutor's "brain"
ELEVENLABS_AGENT_LLM=gemini-3.5-flash
